{
  "name": "@tracepass/code-standard",
  "version": "1.0.0",
  "description": "TracePass's shared coding standard: the ESLint rules and TypeScript compiler settings every TracePass TypeScript repository uses.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "TracePass LTD (https://tracepass.eu)",
  "homepage": "https://github.com/malinoto/tracepass-code-standard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malinoto/tracepass-code-standard.git"
  },
  "keywords": [
    "eslint-config",
    "tsconfig",
    "typescript",
    "coding-standard"
  ],
  "exports": {
    "./eslint": "./typescript/eslint.standard.mjs",
    "./tsconfig.json": "./typescript/tsconfig.standard.json",
    "./package.json": "./package.json",
    "./prettier": "./typescript/prettier.standard.mjs"
  },
  "files": [
    "typescript",
    "git-hooks",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\""
  },
  "peerDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "eslint-plugin-jsdoc": "^65.4.5"
  },
  "prettier": "./typescript/prettier.standard.mjs"
}
