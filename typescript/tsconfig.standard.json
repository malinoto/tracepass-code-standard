// TracePass coding standard — the shared TypeScript compiler settings.
// Published as @tracepass/code-standard. A repo's tsconfig.json extends
// "@tracepass/code-standard/tsconfig.json" and adds only what its runtime needs (module
// system, JSX, paths, includes); it never turns a setting here off.
{
  "compilerOptions": {
    "strict": true,
    // A lookup by index or key (items[0], prices["growth"]) may find nothing; the type
    // says so, and lint stops calling the guard against it unnecessary (owner decision).
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
