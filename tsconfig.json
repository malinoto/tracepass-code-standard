{
  "extends": "./typescript/tsconfig.standard.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "typescript/**/*.mjs"
  ]
}
