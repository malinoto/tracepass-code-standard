{
  "extends": "./typescript/tsconfig.standard.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "jsx": "react-jsx",
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "typescript/**/*.mjs"
  ]
}
